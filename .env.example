# 单管理员模式：用户名默认 admin，密码至少 10 位。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password

# 建议显式设置不少于 32 字符的会话签名密钥。
ADMIN_SESSION_SECRET=replace-with-a-separate-random-session-secret

# DeepSeek 仅由服务端读取。不要把真实 Key 写进代码或提交到 Git。
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat

# 公开分析入口保护。生产环境若经过可信反向代理，再开启 TRUST_PROXY。
ANALYZE_RATE_MAX=20
ANALYZE_RATE_WINDOW_MS=60000
ANALYZE_MAX_CONCURRENT=4
# TRUST_PROXY=true

# 仅本地临时体验可开启；生产环境禁止使用。
# ADMIN_DEV_AUTO_CREDENTIALS=true

# 告警通知：仅服务端读取，后台不会显示或保存 Webhook 地址与令牌。
# ALERT_WEBHOOK_URL=https://example.com/your-webhook
# ALERT_WEBHOOK_TOKEN=replace-with-server-only-token

# 多角色模式可使用 ADMIN_USERS_JSON 替代上面的单管理员配置：
# ADMIN_USERS_JSON=[{"username":"viewer","password":"replace-me-123","role":"viewer"},{"username":"editor","password":"replace-me-456","role":"editor"},{"username":"admin","password":"replace-me-789","role":"admin"}]
