# 单管理员模式：用户名默认 admin，密码至少 10 位。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password

# 建议显式设置不少于 32 字符的会话签名密钥。
ADMIN_SESSION_SECRET=replace-with-a-separate-random-session-secret

# 仅本地临时体验可开启；生产环境禁止使用。
# ADMIN_DEV_AUTO_CREDENTIALS=true

# 多角色模式可使用 ADMIN_USERS_JSON 替代上面的单管理员配置：
# ADMIN_USERS_JSON=[{"username":"viewer","password":"replace-me-123","role":"viewer"},{"username":"editor","password":"replace-me-456","role":"editor"},{"username":"admin","password":"replace-me-789","role":"admin"}]
